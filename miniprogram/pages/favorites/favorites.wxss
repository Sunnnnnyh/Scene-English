.favorites-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 56rpx 32rpx 112rpx;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  background: #f7fbff;
}

.favorites-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.favorites-title {
  display: block;
  color: #19324d;
  font-size: 40rpx;
  font-weight: 800;
}

.favorites-list {
  margin-top: 36rpx;
}

.favorite-item {
  box-sizing: border-box;
  min-height: 128rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(25, 50, 77, 0.08);
}

.favorite-item:active {
  background: #fffaf0;
}

.favorite-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 24rpx;
}

.favorite-copy {
  min-width: 0;
}

.favorite-word {
  display: block;
  color: #19324d;
  font-size: 32rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.favorite-cn {
  display: block;
  margin-top: 8rpx;
  color: #e8754f;
  font-size: 25rpx;
  font-weight: 800;
}

.favorite-scene {
  flex-shrink: 0;
  box-sizing: border-box;
  min-width: 144rpx;
  max-width: 100%;
  padding: 10rpx 16rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #fff4df;
  color: #19324d;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.favorite-detail {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #d7e6f2;
}

.favorite-phonetic {
  display: block;
  color: #5d7892;
  font-size: 24rpx;
  line-height: 1.35;
}

.favorite-expression {
  margin-top: 18rpx;
}

.favorite-expression-label {
  display: block;
  color: #5d7892;
  font-size: 22rpx;
  font-weight: 800;
}

.favorite-expression-line {
  display: block;
  margin-top: 8rpx;
  color: #19324d;
  font-size: 26rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.favorite-expression-translation {
  display: block;
  margin-top: 8rpx;
  color: #45647f;
  font-size: 24rpx;
  line-height: 1.45;
}

.favorite-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.favorite-action-button {
  flex: 1;
  min-height: 72rpx;
  margin: 0;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #fff4df;
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.favorite-action-button:active {
  transform: translateY(1rpx);
}

.favorite-play-button {
  background: #ffe6bb;
}

.favorite-remove-button {
  background: #fff7f5;
  color: #c95445;
}

.favorite-empty {
  margin-top: 42rpx;
  padding: 32rpx;
  border: 2rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
}

.favorite-empty-title {
  display: block;
  color: #19324d;
  font-size: 30rpx;
  font-weight: 800;
}
