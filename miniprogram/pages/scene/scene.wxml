<view class="scene-page">
  <block wx:if="{{!activeMode}}">
    <view class="scene-header">
      <view>
        <text class="scene-kicker">{{sceneNameEn}} Scene</text>
        <text class="scene-title">{{title}}</text>
      </view>
      <text class="scene-count">{{progressLabel}}</text>
    </view>

    <view class="scene-preview">
      <image
        wx:if="{{sceneImageLoadStatus !== 'failed'}}"
        class="scene-image"
        src="{{sceneImage}}"
        mode="aspectFill"
        bindload="onSceneImageLoad"
        binderror="onSceneImageError"
      />
      <view wx:else class="scene-image-fallback">
        <text class="scene-image-fallback__title">Image unavailable.</text>
        <button class="scene-image-fallback__retry" catchtap="onRetrySceneImage">Try again</button>
      </view>
    </view>

    <view class="progress-section">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
      </view>
    </view>

    <view class="scene-actions">
      <button class="scene-word-list-toggle" bindtap="onToggleSceneWordList">
        {{showSceneWordList ? '收起清单' : '单词清单'}}
      </button>
    </view>

    <view wx:if="{{showSceneWordList}}" class="scene-word-list">
      <block wx:for="{{sceneWordList}}" wx:key="wordId">
        <view class="scene-word-list-item {{item.isLearned ? 'scene-word-list-item--learned' : ''}}">
          <view class="scene-word-list-item__copy">
            <text class="scene-word-list-item__word">{{item.en}}</text>
            <text class="scene-word-list-item__cn">{{item.cn}}</text>
          </view>
          <text class="scene-word-list-item__phonetic">{{item.phonetic}}</text>
        </view>
      </block>
    </view>

    <view class="mode-section">
      <text class="section-title">学习模式</text>
      <block wx:for="{{modeEntries}}" wx:key="id">
        <view
          class="mode-entry {{item.isRecommended ? 'mode-entry--recommended' : ''}}"
          data-entry-id="{{item.id}}"
          bindtap="onEntryTap"
        >
          <view class="mode-copy">
            <text class="mode-title">{{item.title}}</text>
          </view>
          <text class="mode-action">{{item.actionLabel}}</text>
        </view>
      </block>
    </view>
  </block>

  <block wx:if="{{activeMode}}">
    <view class="mode-topbar">
      <view class="mode-back-icon" bindtap="onBackToSceneHome" aria-label="Back to scene">
        <text class="mode-back-chevron">‹</text>
      </view>
      <view class="mode-heading">
        <text class="scene-kicker">{{title}}</text>
        <text class="scene-title">{{selectedModeTitle}}</text>
      </view>
    </view>

    <view wx:if="{{activeMode === 'memory'}}" class="memory-progress-section">
      <view class="memory-progress-header">
        <text class="memory-progress-label">单词进度</text>
        <text class="memory-progress-count">{{progressLabel}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
      </view>
    </view>

    <block wx:if="{{activeMode === 'memory'}}">
      <view class="memory-assist">
        <button
          class="memory-hint {{memoryHintButtonDisabled ? 'memory-hint--disabled' : ''}}"
          disabled="{{memoryHintButtonDisabled}}"
          bindtap="onShowMemoryHint"
        >
          {{memoryHintButtonLabel}}
        </button>
        <button class="scene-word-list-toggle scene-word-list-toggle--compact" bindtap="onToggleSceneWordList">
          {{showSceneWordList ? '收起清单' : '单词清单'}}
        </button>
      </view>

      <view wx:if="{{showSceneWordList}}" class="scene-word-list scene-word-list--memory">
        <block wx:for="{{sceneWordList}}" wx:key="wordId">
          <view class="scene-word-list-item {{item.isLearned ? 'scene-word-list-item--learned' : ''}}">
            <view class="scene-word-list-item__copy">
              <text class="scene-word-list-item__word">{{item.en}}</text>
              <text class="scene-word-list-item__cn">{{item.cn}}</text>
            </view>
            <text class="scene-word-list-item__phonetic">{{item.phonetic}}</text>
          </view>
        </block>
      </view>

      <view class="scene-preview mode-page-preview memory-scene-preview" bindtap="onMemoryBlankTap">
        <image
          wx:if="{{sceneImageLoadStatus !== 'failed'}}"
          class="scene-image"
          src="{{sceneImage}}"
          mode="aspectFill"
          bindload="onSceneImageLoad"
          binderror="onSceneImageError"
        />
        <view wx:else class="scene-image-fallback">
          <text class="scene-image-fallback__title">Image unavailable.</text>
          <button class="scene-image-fallback__retry" catchtap="onRetrySceneImage">Try again</button>
        </view>
        <block wx:for="{{memoryHotspots}}" wx:key="hotspotId">
          <view
            class="memory-hotspot {{showMemoryGuide && item.wordId === memoryGuideWordId ? 'memory-hotspot--guided' : ''}} {{memoryHintWordId === item.wordId ? 'memory-hotspot--hinted' : ''}}"
            style="{{item.style}}"
            data-word-id="{{item.wordId}}"
            hover-class="none"
            catchtap="onMemoryHotspotTap"
          ></view>
        </block>
        <view wx:if="{{showMemoryGuide}}" class="memory-guide">
          <text class="memory-guide-title">试试看</text>
          <text class="memory-guide-text">点一点教室里的物品，看看它用英语怎么说</text>
          <button class="memory-guide-close" bindtap="onDismissMemoryGuide">我知道了</button>
        </view>
      </view>

      <view wx:if="{{selectedMemoryWordCard}}" class="memory-word-card">
        <view class="memory-word-card__panel">
          <view class="memory-word-card__header">
            <view>
              <text class="memory-word-card__word">{{selectedMemoryWordCard.en}}</text>
              <view class="memory-word-card__pronunciation">
                <text class="memory-word-card__phonetic">{{selectedMemoryWordCard.phonetic}}</text>
                <view class="memory-word-card__audio" bindtap="onPlayMemoryWordAudio">
                  <text class="memory-word-card__audio-icon">▶</text>
                </view>
                <view
                  class="memory-word-card__favorite {{selectedMemoryWordCard.isFavorite ? 'memory-word-card__favorite--active' : ''}}"
                  bindtap="onToggleMemoryFavorite"
                >
                  <text class="memory-word-card__favorite-icon">{{selectedMemoryWordCard.isFavorite ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
            <view class="memory-word-card__close" bindtap="onCloseMemoryWordCard">
              <text class="memory-word-card__close-icon">×</text>
            </view>
          </view>

          <text class="memory-word-card__cn">{{selectedMemoryWordCard.cn}}</text>

          <view wx:if="{{showMemoryTranslationGuide}}" class="memory-translation-guide">
            点英文句子可以展开中文，再点一次收起。
          </view>

          <view class="memory-word-card__section">
            <text class="memory-word-card__label">Useful expression</text>
            <text
              class="memory-word-card__line"
              data-translation-type="expression"
              bindtap="onToggleMemoryTranslation"
            >
              {{selectedMemoryWordCard.expressionEn}}
            </text>
            <text
              wx:if="{{selectedMemoryWordCard.showExpressionCn}}"
              class="memory-word-card__translation"
            >
              {{selectedMemoryWordCard.expressionCn}}
            </text>
          </view>
        </view>
      </view>
    </block>

    <block wx:elif="{{activeMode === 'listeningWriting'}}">
      <view wx:if="{{listeningWritingIsRoundComplete}}" class="mode-page-panel listening-writing-complete">
        <text class="listening-writing-complete-title">Round complete</text>
        <text class="listening-writing-complete-text">
          You finished this 5-word set. Start a new set when you are ready.
        </text>
        <view class="listening-writing-complete-actions">
          <button class="listening-writing-next-set" bindtap="onRestartListeningWritingRound">
            New 5-word set
          </button>
          <button class="listening-writing-end-practice" bindtap="onEndListeningWritingPractice">
            End practice
          </button>
        </view>
      </view>

      <block wx:else>
        <view
          class="scene-preview mode-page-preview listening-writing-scene-preview"
          data-target-word-id="{{listeningWritingState.currentQuestion.wordId}}"
          bindtap="onListeningWritingBlankTap"
        >
          <image
            wx:if="{{sceneImageLoadStatus !== 'failed'}}"
            class="scene-image"
            src="{{sceneImage}}"
            mode="aspectFill"
            bindload="onSceneImageLoad"
            binderror="onSceneImageError"
          />
          <view wx:else class="scene-image-fallback">
            <text class="scene-image-fallback__title">Image unavailable.</text>
            <button class="scene-image-fallback__retry" catchtap="onRetrySceneImage">Try again</button>
          </view>
          <block wx:for="{{memoryHotspots}}" wx:key="hotspotId">
            <view
              class="listening-writing-hotspot {{listeningWritingTargetWordId === item.wordId ? 'listening-writing-hotspot--target listening-writing-hotspot--flash' : ''}}"
              style="{{item.style}}"
              data-word-id="{{item.wordId}}"
              hover-class="none"
              catchtap="onListeningWritingHotspotTap"
            ></view>
          </block>
        </view>

        <view class="mode-page-panel listening-writing-start">
          <view class="listening-writing-progress">
            <text class="listening-writing-progress-label">Question</text>
            <text class="listening-writing-progress-count">{{listeningWritingState.questionLabel}}</text>
          </view>

          <view
            wx:if="{{!listeningWritingPendingNextQuestion && listeningWritingPhase !== 'spellingReady'}}"
            class="listening-writing-cue"
          >
            <text class="listening-writing-cue-title">{{listeningWritingTaskTitle}}</text>
            <text
              wx:if="{{listeningWritingInstruction && listeningWritingPhase !== 'spellingReady'}}"
              class="listening-writing-cue-text"
            >
              {{listeningWritingInstruction}}
            </text>
          </view>

          <view wx:if="{{listeningWritingAnswerReveal}}" class="listening-writing-answer-card">
            <text class="listening-writing-answer-label">Correct spelling</text>
            <text class="listening-writing-answer-word">{{listeningWritingAnswerReveal}}</text>
          </view>

          <view
            wx:if="{{listeningWritingFeedback}}"
            class="listening-writing-feedback-card {{listeningWritingFeedbackKind === 'success' ? 'listening-writing-feedback-card--success' : ''}} {{listeningWritingFeedbackKind === 'error' ? 'listening-writing-feedback-card--error' : ''}}"
          >
            <text class="listening-writing-feedback">{{listeningWritingFeedback}}</text>
          </view>

          <button
            wx:if="{{!listeningWritingPendingNextQuestion && listeningWritingPhase !== 'spellingReady'}}"
            class="listening-writing-play"
            bindtap="onPlayListeningWritingAudio"
          >
            Play Word Audio
          </button>

          <view
            wx:if="{{listeningWritingPhase === 'spellingReady' && !listeningWritingPendingNextQuestion}}"
            class="listening-writing-spelling"
          >
            <view class="listening-writing-spell-focus">
              <text class="listening-writing-spell-title">Spell now</text>
            </view>
            <input
              class="listening-writing-input"
              value="{{listeningWritingSpellingInput}}"
              placeholder="Type the word you heard"
              confirm-type="done"
              bindinput="onListeningWritingSpellingInput"
            />
            <view class="listening-writing-spell-actions">
              <button class="listening-writing-play-inline" bindtap="onPlayListeningWritingAudio">
                Play audio
              </button>
              <button class="listening-writing-submit" bindtap="onSubmitListeningWritingSpelling">
                Submit
              </button>
            </view>
          </view>

          <button
            wx:if="{{listeningWritingPendingNextQuestion}}"
            class="listening-writing-continue"
            bindtap="onContinueListeningWritingQuestion"
          >
            {{listeningWritingContinueLabel}}
          </button>
        </view>
      </block>
    </block>

    <block wx:elif="{{activeMode === 'listeningSpeaking'}}">
      <view wx:if="{{listeningSpeakingIsRoundComplete}}" class="mode-page-panel listening-speaking-complete">
        <text class="listening-speaking-complete-title">Speaking round complete</text>
        <text class="listening-speaking-complete-text">
          You finished this 5-word speaking set. Start a new set when you are ready.
        </text>
        <view class="listening-speaking-complete-stats">
          <view class="listening-speaking-complete-stat">
            <text class="listening-speaking-complete-stat-value">{{listeningSpeakingCorrectCount}}</text>
            <text class="listening-speaking-complete-stat-label">Correct</text>
          </view>
          <view class="listening-speaking-complete-stat">
            <text class="listening-speaking-complete-stat-value">{{listeningSpeakingMistakeCount}}</text>
            <text class="listening-speaking-complete-stat-label">Mistakes</text>
          </view>
          <view class="listening-speaking-complete-stat">
            <text class="listening-speaking-complete-stat-value">{{listeningSpeakingNewMistakeCount}}</text>
            <text class="listening-speaking-complete-stat-label">New mistakes</text>
          </view>
        </view>
        <view class="listening-speaking-complete-actions">
          <button class="listening-speaking-next-set" bindtap="onRestartListeningSpeakingRound">
            New 5-word set
          </button>
          <button class="listening-speaking-end-practice" bindtap="onEndListeningSpeakingPractice">
            End practice
          </button>
        </view>
      </view>

      <block wx:else>
        <view
          class="scene-preview mode-page-preview listening-speaking-scene-preview"
          data-target-word-id="{{listeningSpeakingState.currentQuestion.wordId}}"
          bindtap="onListeningSpeakingBlankTap"
        >
          <image
            wx:if="{{sceneImageLoadStatus !== 'failed'}}"
            class="scene-image"
            src="{{sceneImage}}"
            mode="aspectFill"
            bindload="onSceneImageLoad"
            binderror="onSceneImageError"
          />
          <view wx:else class="scene-image-fallback">
            <text class="scene-image-fallback__title">Image unavailable.</text>
            <button class="scene-image-fallback__retry" catchtap="onRetrySceneImage">Try again</button>
          </view>
          <block wx:for="{{memoryHotspots}}" wx:key="hotspotId">
            <view
              class="listening-speaking-hotspot {{listeningSpeakingTargetWordId === item.wordId ? 'listening-speaking-hotspot--target listening-writing-hotspot--flash' : ''}}"
              style="{{item.style}}"
              data-word-id="{{item.wordId}}"
              hover-class="none"
              catchtap="onListeningSpeakingHotspotTap"
            ></view>
          </block>
        </view>

        <view class="mode-page-panel listening-speaking-start">
          <view class="listening-speaking-progress">
            <text class="listening-speaking-progress-label">Question</text>
            <text class="listening-speaking-progress-count">{{listeningSpeakingState.questionLabel}}</text>
          </view>

          <view wx:if="{{listeningSpeakingPhase !== 'recordReady'}}" class="listening-speaking-cue">
            <text class="listening-speaking-cue-title">{{listeningSpeakingTaskTitle}}</text>
            <text wx:if="{{listeningSpeakingInstruction}}" class="listening-speaking-cue-text">
              {{listeningSpeakingInstruction}}
            </text>
          </view>

          <view
            wx:if="{{listeningSpeakingFeedback}}"
            class="listening-speaking-feedback-card {{listeningSpeakingFeedbackKind === 'success' ? 'listening-speaking-feedback-card--success' : ''}} {{listeningSpeakingFeedbackKind === 'error' ? 'listening-speaking-feedback-card--error' : ''}}"
          >
            <text class="listening-speaking-feedback">{{listeningSpeakingFeedback}}</text>
          </view>

          <button
            wx:if="{{listeningSpeakingPhase !== 'recordReady'}}"
            class="listening-speaking-play"
            bindtap="onPlayListeningSpeakingAudio"
          >
            Play Word Audio
          </button>

          <view wx:if="{{listeningSpeakingPhase === 'recordReady'}}" class="listening-speaking-record-ready">
            <text class="listening-speaking-record-title">Ready to speak</text>
            <text class="listening-speaking-record-text">Say the word you heard.</text>
            <text
              wx:if="{{listeningSpeakingRecordingFeedback && !listeningSpeakingRecognitionFeedback}}"
              class="listening-speaking-record-feedback"
            >
              {{listeningSpeakingRecordingFeedback}}
            </text>
            <view
              wx:if="{{listeningSpeakingRecognitionFeedback}}"
              class="listening-speaking-recognition-card {{listeningSpeakingRecognitionStatus === 'passed' ? 'listening-speaking-recognition-card--success' : ''}} {{listeningSpeakingRecognitionStatus === 'notRecognized' || listeningSpeakingRecognitionStatus === 'failed' ? 'listening-speaking-recognition-card--error' : ''}}"
            >
              <view class="listening-speaking-recognition-label">
                <block wx:if="{{listeningSpeakingRecognitionStatus === 'recognizing'}}">Checking...</block>
                <block wx:elif="{{listeningSpeakingRecognitionStatus === 'passed'}}">Passed</block>
                <block wx:else>Try again</block>
              </view>
              <view class="listening-speaking-recognition-text">
                {{listeningSpeakingRecognitionFeedback}}
              </view>
            </view>
            <view wx:if="{{listeningSpeakingAnswerReveal}}" class="listening-speaking-answer-card">
              <text class="listening-speaking-answer-label">Correct pronunciation</text>
              <text class="listening-speaking-answer-word">{{listeningSpeakingAnswerReveal}}</text>
            </view>
            <view
              wx:if="{{listeningSpeakingRecognitionStatus !== 'passed' && listeningSpeakingRecognitionStatus !== 'recognizing' && !listeningSpeakingPendingNextQuestion}}"
              class="listening-speaking-record-actions"
            >
              <button
                wx:if="{{listeningSpeakingRecordingStatus !== 'recording' && listeningSpeakingRecordingStatus !== 'recorded'}}"
                class="listening-speaking-record-button"
                bindtap="onStartListeningSpeakingRecording"
              >
                <block
                  wx:if="{{listeningSpeakingRecordingStatus === 'tooShort' || listeningSpeakingRecordingStatus === 'permissionDenied'}}"
                >
                  Try Again
                </block>
                <block wx:else>Start Recording</block>
              </button>
              <button
                wx:if="{{listeningSpeakingRecordingStatus === 'recorded' && listeningSpeakingRecognitionStatus !== 'passed'}}"
                class="listening-speaking-record-button listening-speaking-record-button--secondary listening-speaking-record-button--again"
                bindtap="onStartListeningSpeakingRecording"
              >
                Record Again
              </button>
              <button
                wx:if="{{listeningSpeakingRecordingStatus === 'recording'}}"
                class="listening-speaking-record-button listening-speaking-record-button--stop"
                bindtap="onStopListeningSpeakingRecording"
              >
                Stop
              </button>
              <button
                wx:if="{{listeningSpeakingRecordingStatus === 'recording'}}"
                class="listening-speaking-record-button listening-speaking-record-button--secondary"
                bindtap="onCancelListeningSpeakingRecording"
              >
                Cancel
              </button>
            </view>
            <button
              wx:if="{{listeningSpeakingPendingNextQuestion}}"
              class="listening-speaking-continue"
              bindtap="onContinueListeningSpeakingQuestion"
            >
              {{listeningSpeakingContinueLabel}}
            </button>
          </view>
        </view>
      </block>
    </block>

    <block wx:else>
      <view class="scene-preview mode-page-preview">
        <image
          wx:if="{{sceneImageLoadStatus !== 'failed'}}"
          class="scene-image"
          src="{{sceneImage}}"
          mode="aspectFill"
          bindload="onSceneImageLoad"
          binderror="onSceneImageError"
        />
        <view wx:else class="scene-image-fallback">
          <text class="scene-image-fallback__title">Image unavailable.</text>
          <button class="scene-image-fallback__retry" catchtap="onRetrySceneImage">Try again</button>
        </view>
      </view>

    </block>
  </block>
  <view wx:if="{{sceneFeedbackToast}}" class="scene-feedback-toast">
    <text class="scene-feedback-toast__text">{{sceneFeedbackToast}}</text>
  </view>
</view>
