.scene-page {
  box-sizing: border-box;
  height: 100vh;
  overflow-y: auto;
  padding: 42rpx 32rpx 112rpx;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  background: #f7fbff;
}

.scene-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.scene-kicker {
  display: block;
  color: #5d7892;
  font-size: 24rpx;
  font-weight: 700;
}

.scene-title {
  display: block;
  margin-top: 8rpx;
  color: #19324d;
  font-size: 42rpx;
  font-weight: 800;
}

.scene-count {
  flex-shrink: 0;
  color: #e8754f;
  font-size: 24rpx;
  font-weight: 800;
}

.scene-preview {
  position: relative;
  margin-top: 30rpx;
  overflow: hidden;
  min-height: 380rpx;
  border: 3rpx solid #19324d;
  border-radius: 24rpx;
  background: #eaf5ff;
  box-shadow: 0 16rpx 32rpx rgba(25, 50, 77, 0.08);
}

.scene-image {
  display: block;
  width: 100%;
  height: 380rpx;
}

.scene-image-fallback {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  min-height: 380rpx;
  padding: 36rpx;
  background: #eef7ff;
}

.scene-image-fallback__title {
  color: #19324d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.scene-image-fallback__retry {
  width: auto;
  min-width: 132rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
}

.scene-image-fallback__retry:active {
  background: #fff4df;
}

.scene-feedback-toast {
  position: fixed;
  left: 50%;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  z-index: 20;
  box-sizing: border-box;
  max-width: 640rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(25, 50, 77, 0.82);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
  transform: translateX(-50%);
}

.scene-feedback-toast__text {
  display: block;
}

.progress-section {
  margin-top: 20rpx;
}

.progress-track {
  overflow: hidden;
  height: 16rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffffff;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ff946f;
}

.scene-actions {
  display: flex;
  margin-top: 20rpx;
}

.scene-word-list-toggle {
  flex: 1;
  box-sizing: border-box;
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.scene-word-list-toggle:active {
  background: #fff4df;
}

.scene-word-list-toggle--compact {
  width: 0;
}

.scene-word-list {
  overflow: hidden;
  margin-top: 18rpx;
  border: 3rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
}

.scene-word-list--memory {
  margin-top: 16rpx;
}

.scene-word-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 14rpx 18rpx;
  border-top: 2rpx solid #d7e6f2;
  background: #ffffff;
}

.scene-word-list-item:first-child {
  border-top: 0;
}

.scene-word-list-item--learned {
  background: #ffffff;
  box-shadow: inset 8rpx 0 0 #a6dfb2;
}

.scene-word-list-item__copy {
  min-width: 0;
  flex: 1;
}

.scene-word-list-item__word {
  display: block;
  color: #19324d;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.scene-word-list-item__cn {
  display: block;
  margin-top: 4rpx;
  color: #5d7892;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.scene-word-list-item__phonetic {
  flex: 0 1 230rpx;
  color: #5d7892;
  font-size: 20rpx;
  line-height: 1.2;
  text-align: right;
  overflow-wrap: anywhere;
}

.mode-section {
  margin-top: 40rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #19324d;
  font-size: 30rpx;
  font-weight: 800;
}

.mode-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  min-height: 142rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
}

.mode-entry--recommended {
  background: #fff4df;
}

.mode-copy {
  min-width: 0;
}

.mode-title {
  display: block;
  color: #19324d;
  font-size: 30rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.mode-action {
  flex-shrink: 0;
  min-width: 176rpx;
  box-sizing: border-box;
  padding: 11rpx 16rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.scene-tutor-section {
  margin-top: 34rpx;
}

.scene-tutor-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  min-height: 166rpx;
  padding: 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 22rpx;
  background: #eef7ff;
}

.scene-tutor-copy {
  min-width: 0;
  flex: 1;
}

.scene-tutor-label {
  display: block;
  color: #19324d;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.scene-tutor-supporting-text {
  display: block;
  margin-top: 8rpx;
  color: #45647f;
  font-size: 23rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.scene-tutor-capabilities {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.scene-tutor-capability {
  box-sizing: border-box;
  padding: 7rpx 12rpx;
  border: 2rpx solid #d7e6f2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.scene-tutor-action {
  flex-shrink: 0;
  min-width: 128rpx;
  box-sizing: border-box;
  padding: 11rpx 16rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #19324d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.scene-tutor-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
}

.scene-tutor-panel-empty {
  display: block;
  color: #45647f;
  font-size: 26rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.scene-tutor-panel-kicker {
  display: block;
  color: #5d7892;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.scene-tutor-panel-title {
  display: block;
  color: #19324d;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
}

.scene-tutor-panel-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scene-tutor-panel-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #d7e6f2;
  border-radius: 18rpx;
  background: #f7fbff;
}

.scene-tutor-panel-action-copy {
  min-width: 0;
  flex: 1;
}

.scene-tutor-panel-action-title {
  display: block;
  color: #19324d;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: left;
  overflow-wrap: anywhere;
}

.scene-tutor-panel-action-text {
  display: block;
  margin-top: 8rpx;
  color: #45647f;
  font-size: 22rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.scene-tutor-panel-action-label {
  flex-shrink: 0;
  min-width: 92rpx;
  box-sizing: border-box;
  padding: 9rpx 14rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.scene-tutor-ask-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scene-tutor-ask-title {
  display: block;
  color: #19324d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.scene-tutor-ask-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 148rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #d7e6f2;
  border-radius: 18rpx;
  background: #f7fbff;
  color: #19324d;
  font-size: 25rpx;
  line-height: 1.4;
}

.scene-tutor-recommended-questions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.scene-tutor-recommended-question {
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border: 2rpx solid #d7e6f2;
  border-radius: 16rpx;
  background: #ffffff;
}

.scene-tutor-recommended-question:active {
  background: #fff4df;
}

.scene-tutor-recommended-question-text {
  display: block;
  color: #45647f;
  font-size: 23rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.scene-tutor-ask-submit {
  margin: 4rpx 0 0;
  min-height: 78rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #f38d68;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.scene-tutor-ask-submit--disabled {
  border-color: #9db1c2;
  background: #eef6fc;
  color: #5d7892;
  opacity: 1;
}

.scene-tutor-response-state,
.scene-tutor-response-error,
.scene-tutor-ask-result-preview {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
}

.scene-tutor-response-state {
  border: 2rpx solid #d7e6f2;
  background: #f7fbff;
}

.scene-tutor-response-state-text,
.scene-tutor-response-error-text,
.scene-tutor-ask-result-answer {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.scene-tutor-response-state-text {
  color: #5d7892;
}

.scene-tutor-response-error {
  border: 2rpx solid #ffd4c5;
  background: #fff6f1;
}

.scene-tutor-response-error-text {
  color: #c95f3c;
  font-weight: 800;
}

.scene-tutor-ask-result-preview {
  border: 2rpx solid #d7e6f2;
  background: #ffffff;
}

.scene-tutor-ask-result-answer {
  color: #19324d;
  font-weight: 700;
}

.mode-topbar {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.mode-heading {
  min-width: 0;
  flex: 1;
}

.mode-back-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #19324d;
  line-height: 1;
}

.mode-back-chevron {
  display: block;
  color: #19324d;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.mode-back-icon:active {
  opacity: 0.62;
}

.memory-progress-section {
  margin-top: 24rpx;
}

.memory-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.memory-progress-label {
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
}

.memory-progress-count {
  flex-shrink: 0;
  color: #e8754f;
  font-size: 22rpx;
  font-weight: 800;
}

.mode-page-preview {
  margin-top: 34rpx;
}

.memory-assist {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.memory-scene-preview {
  position: relative;
  height: 380rpx;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
}

.memory-hotspot {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  background: transparent;
  opacity: 0;
}

.memory-hotspot--hinted {
  border: 4rpx solid #ff7f5f;
  border-radius: 999rpx;
  background: rgba(255, 148, 111, 0.24);
  opacity: 1;
  box-shadow:
    0 0 0 12rpx rgba(255, 148, 111, 0.16),
    0 0 24rpx rgba(255, 148, 111, 0.22);
}

.memory-guide {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 3;
  box-sizing: border-box;
  max-width: 420rpx;
  padding: 22rpx 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 22rpx;
  background: #fff4df;
  box-shadow: 0 14rpx 30rpx rgba(25, 50, 77, 0.14);
}

.memory-guide-title {
  display: block;
  color: #19324d;
  font-size: 26rpx;
  font-weight: 800;
}

.memory-guide-text {
  display: block;
  margin-top: 8rpx;
  color: #45647f;
  font-size: 24rpx;
  line-height: 1.45;
}

.memory-guide-close {
  margin: 18rpx 0 0;
  min-height: 64rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
}

.mode-page-panel {
  margin-top: 28rpx;
  padding: 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
}

.listening-writing-start {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.listening-writing-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #d7e6f2;
}

.listening-writing-progress-label {
  color: #5d7892;
  font-size: 24rpx;
  font-weight: 800;
}

.listening-writing-progress-count {
  flex-shrink: 0;
  color: #e8754f;
  font-size: 30rpx;
  font-weight: 800;
}

.listening-writing-cue {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  box-sizing: border-box;
  min-height: 70rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid #d7e6f2;
  border-radius: 18rpx;
  background: #f7fbff;
}

.listening-writing-cue-title {
  flex-shrink: 0;
  color: #19324d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.listening-writing-cue-text {
  min-width: 0;
  color: #5d7892;
  font-size: 21rpx;
  line-height: 1.3;
  text-align: right;
  overflow-wrap: anywhere;
}

.listening-writing-play {
  margin: 2rpx 0 0;
  min-height: 84rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #f38d68;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
}

.listening-writing-play:active {
  background: #e8754f;
}

.listening-writing-scene-preview {
  position: relative;
}

.listening-writing-hotspot {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  background: transparent;
  opacity: 0;
}

.listening-writing-hotspot--target {
  border: 4rpx solid #ff946f;
  border-radius: 999rpx;
  background: rgba(255, 148, 111, 0.26);
  opacity: 1;
  box-shadow:
    0 0 0 12rpx rgba(255, 148, 111, 0.18),
    0 0 28rpx rgba(255, 148, 111, 0.24);
}

.listening-writing-hotspot--flash {
  animation: targetFlash 0.42s ease-in-out 3;
}

@keyframes targetFlash {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.22;
    transform: scale(1.05);
  }
}

.listening-writing-feedback {
  display: block;
  color: #19324d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.listening-writing-feedback-card {
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #d7e6f2;
  border-radius: 16rpx;
  background: #f7fbff;
  box-shadow: inset 8rpx 0 0 #6ea9d7;
}

.listening-writing-feedback-card--success {
  background: #eef9ef;
  box-shadow: inset 8rpx 0 0 #58a95a;
}

.listening-writing-feedback-card--error {
  background: #fff4df;
  box-shadow: inset 8rpx 0 0 #f38d68;
}

.listening-writing-answer-card {
  padding: 22rpx;
  border: 2rpx solid #f1c777;
  border-radius: 16rpx;
  background: #fff4df;
}

.listening-writing-answer-label {
  display: block;
  color: #5d7892;
  font-size: 22rpx;
  font-weight: 800;
}

.listening-writing-answer-word {
  display: block;
  margin-top: 8rpx;
  color: #19324d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.listening-writing-spelling {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(255, 148, 111, 0.46);
  border-radius: 20rpx;
  background: #fffaf2;
}

.listening-writing-spell-focus {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.listening-writing-spell-title {
  color: #19324d;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.listening-writing-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  padding: 0 24rpx;
  border: 3rpx solid #19324d;
  border-radius: 18rpx;
  background: #ffffff;
  color: #19324d;
  font-size: 31rpx;
  font-weight: 800;
}

.listening-writing-spell-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.listening-writing-play-inline {
  flex: 1;
  margin: 0;
  min-height: 78rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #f38d68;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.listening-writing-play-inline:active {
  background: #e8754f;
}

.listening-writing-submit {
  flex: 1;
  margin: 0;
  min-height: 78rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #19324d;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.listening-writing-submit:active {
  background: #2b4c6d;
}

.listening-writing-continue {
  margin: 0;
  min-height: 78rpx;
  border: 2rpx solid #19324d;
  border-radius: 14rpx;
  background: #19324d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.listening-writing-continue:active {
  background: #2b4c6d;
}

.listening-writing-complete {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.listening-writing-complete-title {
  display: block;
  color: #19324d;
  font-size: 38rpx;
  font-weight: 800;
}

.listening-writing-complete-text {
  display: block;
  color: #45647f;
  font-size: 26rpx;
  line-height: 1.5;
}

.listening-writing-complete-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.listening-speaking-complete {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.listening-speaking-complete-title {
  display: block;
  color: #19324d;
  font-size: 38rpx;
