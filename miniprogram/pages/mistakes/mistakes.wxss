.mistakes-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 64rpx 40rpx 112rpx;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  background: #f7fbff;
}

.mistakes-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mistakes-title {
  display: block;
  color: #19324d;
  font-size: 40rpx;
  font-weight: 800;
}

.mistakes-subtitle {
  display: block;
  color: #45647f;
  font-size: 26rpx;
  line-height: 1.5;
}

.mistakes-practice-button {
  display: inline-flex;
  align-self: flex-start;
  align-items: center;
  justify-content: center;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 12rpx 24rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #ffe6d8;
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
  white-space: nowrap;
}

.mistakes-practice-button:active {
  transform: translateY(1rpx);
}

.mistakes-list {
  margin-top: 36rpx;
}

.mistake-item {
  box-sizing: border-box;
  margin-bottom: 22rpx;
  padding: 24rpx 24rpx 18rpx;
  border: 2rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(25, 50, 77, 0.08);
}

.mistake-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.mistake-copy {
  min-width: 0;
}

.mistake-word {
  display: block;
  color: #19324d;
  font-size: 32rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.mistake-cn {
  display: block;
  margin-top: 8rpx;
  color: #e8754f;
  font-size: 25rpx;
  font-weight: 800;
}

.mistake-meta {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.mistake-scene {
  box-sizing: border-box;
  min-width: 144rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid #19324d;
  border-radius: 999rpx;
  background: #fff4df;
  color: #19324d;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.mistake-count {
  color: #c95445;
  font-size: 22rpx;
  font-weight: 800;
}

.mistake-time {
  display: block;
  margin-top: 14rpx;
  color: #5d7892;
  font-size: 22rpx;
}

.mistake-type-list {
  margin-top: 18rpx;
  border-top: 2rpx solid #d7e6f2;
}

.mistake-type-item {
  padding-top: 18rpx;
}

.mistake-type-item + .mistake-type-item {
  margin-top: 18rpx;
  border-top: 2rpx solid #edf4fa;
}

.mistake-type-row,
.mistake-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mistake-type-trailing {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 18rpx;
  margin-left: auto;
}

.mistake-type-label {
  flex: 1;
  min-width: 0;
  color: #19324d;
  font-size: 24rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.mistake-type-count {
  flex-shrink: 0;
  color: #c95445;
  font-size: 22rpx;
  font-weight: 800;
}

.mistake-progress-row {
  margin-top: 12rpx;
}

.mistake-progress-track {
  flex: 1;
  height: 8rpx;
  overflow: hidden;
  border: 2rpx solid #45647f;
  border-radius: 999rpx;
  background: #eef6fb;
}

.mistake-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #9fd9c8;
}

.mistake-actions {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.mistake-remove-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 11rpx 20rpx;
  border: 2rpx solid #c95445;
  border-radius: 999rpx;
  background: transparent;
  color: #c95445;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.1;
  white-space: nowrap;
}

.mistake-remove-button:active {
  transform: translateY(1rpx);
}

.mistakes-empty {
  margin-top: 42rpx;
  padding: 32rpx;
  border: 2rpx solid #19324d;
  border-radius: 22rpx;
  background: #ffffff;
}

.mistakes-empty-title {
  display: block;
  color: #19324d;
  font-size: 30rpx;
  font-weight: 800;
}

.mistakes-empty-description {
  display: block;
  margin-top: 12rpx;
  color: #45647f;
  font-size: 25rpx;
  line-height: 1.5;
}
